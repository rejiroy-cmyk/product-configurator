# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── OS / editor noise ────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Claude Code local settings (machine-specific) ────────────
.claude/settings.local.json

# ── Build output (regenerable via `npm run build`) ───────────
/dist.zip
/old_dist/
/dist_*.js
/dist_javascript_extracted.js

# ── Auto-generated build backups (use git history instead) ───
/backups/

# ── Archived scratch (reversible — delete when confident) ────
/_archive/
/scratch/

# ── Logs & local file backups ────────────────────────────────
*.log
*.bak

# ── Secrets — live SAP/profishop session cookies (never commit) ─
cookie.txt
**/cookie.txt

# ── Scraper experiments & run-output dumps (regenerable) ─────
#   The real scraper tools (scrape-*.js, inject-*.js, etc.) stay
#   tracked; only throwaway probes and screenshots are ignored.
/st-scraper/test-*.js
/st-scraper/test_*.js
/st-scraper/recon-*.js
/st-scraper/poc-*.js
/st-scraper/sanitas-scraped.json
/st-scraper/*.png
/st-scraper/*.html
/st-scraper/*.log

# Local pre-injection data backups (large; use git history instead)
custom-data.json.bak*

# Build-copied images. public/img/ is the tracked source of truth (133 MB); Vite
# copies it verbatim into dist/img/ on every build, so tracking both would double
# the repo for zero benefit. dist/index.html stays tracked as before.
/dist/img/

# Label re-scrape working files (regenerate with audit-truncated-labels.cjs)
/st-scraper/truncated-shard-*.json
/st-scraper/truncated-worklist.json
/st-scraper/text-refetch-shard-*.json
